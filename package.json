{
  "name": "@dsh-external/dsh-antigravity-bridge",
  "version": "0.1.0",
  "description": "Native TypeScript Antigravity (Gemini Agent) Bridge for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "antigravity",
    "gemini"
  ],
  "author": "JoyJ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMJoyJ/dsh-antigravity-bridge.git"
  },
  "homepage": "https://github.com/IMJoyJ/dsh-antigravity-bridge",
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@deepseek-ai/schemastery": "^3.18.1-rc.4",
    "protobufjs": "^7.4.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.3"
  }
}
